{
  "name": "ascii-rpg",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@9.12.0",
  "scripts": {
    "dev": "pnpm --filter @rpg/game dev",
    "build": "pnpm -r build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:snap": "vitest run tools/harness",
    "snap:update": "SNAP_UPDATE=1 vitest run tools/harness",
    "bench": "vitest bench --run"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
